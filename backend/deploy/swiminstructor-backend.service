# /etc/systemd/system/swiminstructor-backend.service
[Unit]
Description=SwimInstructor Backend
After=network.target

[Service]
Type=simple
User=swiminstructor
Group=swiminstructor
WorkingDirectory=/opt/swiminstructor/backend
# Enthaelt API_TOKEN (Rechte 600, gehoert root). systemd liest die Datei vor dem Rechtewechsel.
EnvironmentFile=/etc/swiminstructor/backend.env
ExecStart=/usr/bin/node dist/server.js
Restart=on-failure
RestartSec=3

# Der Dienst schreibt nur nach stdout (-> journalctl) und braucht keine Rechte.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
