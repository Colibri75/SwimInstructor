# /etc/nginx/sites-available/swiminstructor  (danach nach sites-enabled verlinken)
#
# VARIANTE A (empfohlen): eigener Hostname fuer die API, z. B. swim-api.example.net.
# Der bestehende Server-Block der Financial-App bleibt unangetastet. Zertifikat danach mit:
#   sudo certbot --nginx -d swim-api.example.net
# certbot ergaenzt den 443-Block und die Weiterleitung von HTTP auf HTTPS selbst.

# Begrenzt Anfragen pro IP (Schutz vor Dauerfeuer auf die Token-Pruefung).
limit_req_zone $binary_remote_addr zone=swim_api:10m rate=10r/s;

server {
    listen 80;
    listen [::]:80;
    server_name swim-api.example.net;   # <- deinen API-Hostnamen eintragen

    client_max_body_size 200k;

    location / {
        limit_req zone=swim_api burst=20 nodelay;

        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Claude-Aufrufe (ab M5) koennen laenger dauern.
        proxy_read_timeout 90s;
    }
}

# VARIANTE B: kein zweiter Hostname moeglich. Dann in den bestehenden HTTPS-Server-Block
# (den mit dem Zertifikat deines DynDNS-Namens) diesen location-Block einfuegen. Das
# abschliessende "/" bei proxy_pass entfernt den Praefix, die App braucht keine Aenderung.
# Die App erreichst du dann unter https://<dein-hostname>/swim/health
#
#   location /swim/ {
#       limit_req zone=swim_api burst=20 nodelay;   # die limit_req_zone von oben vorher anlegen
#       proxy_pass http://127.0.0.1:3000/;
#       proxy_http_version 1.1;
#       proxy_set_header Host              $host;
#       proxy_set_header X-Real-IP         $remote_addr;
#       proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
#       proxy_set_header X-Forwarded-Proto $scheme;
#       proxy_read_timeout 90s;
#   }
