# Server (Docker): nur API_TOKEN in /etc/swiminstructor/backend.env, der Rest steht in compose.yaml.
# Lokal: Kopie als .env, nie einchecken.

# Pflicht. Geheimer Token des Besitzers, den die App im Header "Authorization: Bearer <token>" schickt.
# Weitere Nutzer: node dist/cli/users.js (siehe docs/backend-deploy.md).
# Erzeugen mit: openssl rand -hex 32
API_TOKEN=

# Optional
PORT=3000
# Nur lokal lauschen; von aussen kommt nur der Reverse-Proxy (Caddy) heran.
HOST=127.0.0.1
LOG_LEVEL=info
NODE_ENV=production

# --- Plan-Erzeugung (siehe docs/plan-generation.md) ---
# Anthropic-API-Key von https://console.anthropic.com. Ohne Key startet der Server trotzdem,
# /v1/plan/today liefert dann nur gespeicherte Plaene.
ANTHROPIC_API_KEY=
#PLAN_MODEL=claude-opus-5-5
#PLAN_EFFORT=high
#PLAN_TIMEOUT_MS=75000
#PLAN_MACRO_TIMEOUT_MS=180000
#PLAN_SERVER_FALLBACK=true
#DATA_DIR=./data
#PLAN_TIMEZONE=Europe/Berlin
# Aufrufbudget je Nutzer und fuer den ganzen Server (Kostenbremse)
#PLAN_MAX_GENERATIONS_PER_HOUR=5
#PLAN_MAX_GENERATIONS_PER_DAY=20
#PLAN_MAX_GENERATIONS_TOTAL_PER_HOUR=15
#PLAN_MAX_GENERATIONS_TOTAL_PER_DAY=60

# --- Alarme (siehe docs/backend-deploy.md, Monitoring) ---
#ALERT_WEBHOOK_URL=https://ntfy.sh/<geheimes-thema>
#ALERT_WEBHOOK_FORMAT=ntfy
#ALERT_DAILY_COST_USD=5
#ALERT_FAILURES_PER_HOUR=3
#ALERT_FAILURE_RATE=0.5

