# Server (Docker): nur API_TOKEN in /etc/swiminstructor/backend.env, der Rest steht in compose.yaml.
# Lokal: Kopie als .env, nie einchecken.

# Pflicht. Geheimer Token, den die App im Header "Authorization: Bearer <token>" schickt.
# Erzeugen mit: openssl rand -hex 32
API_TOKEN=

# Optional
PORT=3000
# Nur lokal lauschen; von aussen kommt nur der Reverse-Proxy (Caddy) heran.
HOST=127.0.0.1
LOG_LEVEL=info
NODE_ENV=production
