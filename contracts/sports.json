{
  "schema_version": 1,
  "measures": ["distance", "duration", "repetitions"],
  "targets": ["pace_per_100m", "pace_per_km", "speed", "heart_rate_zone", "power", "cadence", "stroke_rate", "perceived_effort"],
  "athlete_metrics": [
    {"id": "max_heart_rate", "display_name": "Maximalpuls", "unit": "bpm", "min": 120, "max": 230},
    {"id": "resting_heart_rate", "display_name": "Ruhepuls", "unit": "bpm", "min": 30, "max": 110}
  ],
  "sports": [
    {
      "id": "swim",
      "display_name": "Schwimmen",
      "measures": ["distance", "duration"],
      "targets": ["pace_per_100m", "heart_rate_zone", "perceived_effort"],
      "goal_speed": {"min_meters_per_second": 0.15, "max_meters_per_second": 2.5},
      "load_factor": 1,
      "plan_unit": "meters",
      "typical_speed_meters_per_second": 0.8,
      "performance_metrics": [
        {"id": "css_pace_per_100m", "display_name": "CSS-Pace", "unit": "s/100m", "min": 50, "max": 300}
      ],
      "performance_tests": [
        {"id": "css_400_200", "display_name": "CSS-Test 400/200 m", "produces": ["css_pace_per_100m"], "maximal_effort": true, "duration_minutes": 10},
        {"id": "time_trial_1000m", "display_name": "1000-m-Test", "produces": ["css_pace_per_100m"], "maximal_effort": true, "duration_minutes": 20}
      ]
    },
    {
      "id": "bike",
      "display_name": "Radfahren",
      "measures": ["duration", "distance"],
      "targets": ["power", "heart_rate_zone", "speed", "cadence", "perceived_effort"],
      "goal_speed": {"min_meters_per_second": 2, "max_meters_per_second": 20},
      "load_factor": 0.8,
      "plan_unit": "minutes",
      "typical_speed_meters_per_second": 7,
      "performance_metrics": [
        {"id": "threshold_heart_rate", "display_name": "Schwellenpuls", "unit": "bpm", "min": 100, "max": 215},
        {"id": "threshold_power", "display_name": "Schwellenleistung (FTP)", "unit": "W", "min": 50, "max": 600}
      ],
      "performance_tests": [
        {"id": "threshold_30min", "display_name": "30-Minuten-Test", "produces": ["threshold_heart_rate", "threshold_power"], "maximal_effort": true, "duration_minutes": 30}
      ]
    },
    {
      "id": "run",
      "display_name": "Laufen",
      "measures": ["distance", "duration"],
      "targets": ["pace_per_km", "heart_rate_zone", "cadence", "perceived_effort"],
      "goal_speed": {"min_meters_per_second": 1, "max_meters_per_second": 7},
      "load_factor": 1,
      "plan_unit": "minutes",
      "typical_speed_meters_per_second": 2.8,
      "performance_metrics": [
        {"id": "threshold_heart_rate", "display_name": "Schwellenpuls", "unit": "bpm", "min": 100, "max": 215},
        {"id": "threshold_pace_per_km", "display_name": "Schwellentempo", "unit": "s/km", "min": 150, "max": 900}
      ],
      "performance_tests": [
        {"id": "threshold_30min", "display_name": "30-Minuten-Test", "produces": ["threshold_heart_rate", "threshold_pace_per_km"], "maximal_effort": true, "duration_minutes": 30},
        {"id": "entry_easy_25min", "display_name": "Einstiegstest locker", "produces": ["threshold_pace_per_km"], "maximal_effort": false, "duration_minutes": 25}
      ]
    }
  ]
}
