default_platform(:ios)

platform :ios do
  desc "Generate the Xcode project from project.yml"
  private_lane :generate_project do
    sh("xcodegen", "generate", chdir: "..")
  end

  desc "Run the unit test suite"
  lane :test do
    generate_project
    run_tests(
      scheme: "SwimInstructor",
      devices: ["iPhone 15"]
    )
  end

  desc "Build, sign and upload a new build to TestFlight"
  lane :beta do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: true
    )

    generate_project

    match(type: "appstore", readonly: is_ci)

    increment_build_number(
      build_number: (latest_testflight_build_number + 1).to_s,
      xcodeproj: "SwimInstructor.xcodeproj"
    )

    build_app(
      scheme: "SwimInstructor",
      export_method: "app-store"
    )

    upload_to_testflight(skip_waiting_for_build_processing: true)
  end
end
