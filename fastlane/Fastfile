require "fileutils"
require "json"

default_platform(:ios)

platform :ios do
  desc "Generate the Xcode project from project.yml"
  private_lane :generate_project do
    # sh runs from the fastlane/ folder by default; its own chdir: option isn't reliable here,
    # so change the process working directory explicitly before invoking xcodegen.
    Dir.chdir("..") do
      sh("xcodegen generate")
    end
  end

  desc "Run the unit test suite"
  lane :test do
    # generate_project doubles as a project.yml validation smoke test.
    generate_project

    # All current tests live in the SwimInstructorCore package; swift test runs them directly
    # without needing a simulator, and doesn't depend on wiring the package into an Xcode scheme.
    Dir.chdir("../Packages/SwimInstructorCore") do
      sh("swift test --enable-code-coverage")

      # Coverage pro Datei ins CI-Log (Definition of Done M3: Kernlogik > 80 %). Reines
      # Reporting - ein Problem hier darf die Tests nicht rot machen.
      begin
        bundle = Dir.glob(".build/debug/*.xctest").first
        raise "kein .xctest-Bundle gefunden" if bundle.nil?
        binary = File.join(bundle, "Contents", "MacOS", File.basename(bundle, ".xctest"))
        sh("xcrun llvm-cov report '#{binary}' -instr-profile=.build/debug/codecov/default.profdata " \
           "-ignore-filename-regex='\\.build|Tests'")
      rescue StandardError => e
        UI.important("Coverage-Report nicht verfuegbar: #{e.message}")
      end

      # Sport-Module (Triathlon-Umbau, Sources/.../Sports/): mindestens 90 % Zeilen-Coverage, sonst rot.
      # Anders als der Report oben ist das eine Pruefung: Ohne Coverage-Daten schlaegt sie ebenfalls fehl.
      check_sports_coverage(minimum_percent: 90)
    end

    # App-Code (iPhone + eingebettete Watch-App) mitkompilieren, ohne Signatur. Sonst fielen
    # Fehler in App/ und WatchApp/ erst in der beta-Lane nach dem Merge auf main auf.
    Dir.chdir("..") do
      sh(
        "xcodebuild", "build",
        "-project", "SwimInstructor.xcodeproj",
        "-scheme", "SwimInstructor",
        "-configuration", "Debug",
        "-destination", "generic/platform=iOS",
        "CODE_SIGNING_ALLOWED=NO",
        "-quiet"
      )
    end
  end

  # Liest die Zeilen-Coverage aller Dateien unter Sports/ aus dem letzten `swift test --enable-code-coverage`
  # (laeuft im Package-Ordner) und bricht ab, wenn eine darunter liegt.
  private_lane :check_sports_coverage do |options|
    minimum = options[:minimum_percent]
    bundle = Dir.glob(".build/debug/*.xctest").first
    UI.user_error!("Sport-Coverage: kein .xctest-Bundle gefunden") if bundle.nil?
    binary = File.join(bundle, "Contents", "MacOS", File.basename(bundle, ".xctest"))
    output = sh("xcrun llvm-cov export -summary-only '#{binary}' " \
                "-instr-profile=.build/debug/codecov/default.profdata", log: false)
    files = JSON.parse(output).dig("data", 0, "files") || []
    sports = files.select { |file| file["filename"].include?("/Sources/SwimInstructorCore/Sports/") }
    UI.user_error!("Sport-Coverage: keine Dateien unter Sports/ gefunden") if sports.empty?

    too_low = sports.filter_map do |file|
      percent = file.dig("summary", "lines", "percent").to_f
      UI.message(format("Sport-Coverage %5.1f %%  %s", percent, File.basename(file["filename"])))
      "#{File.basename(file['filename'])} (#{percent.round(1)} %)" if percent < minimum
    end
    UI.user_error!("Sport-Coverage unter #{minimum} %: #{too_low.join(', ')}") unless too_low.empty?
  end

  # Von Hand (Workflow "Profile erneuern"): erzeugt die App-Store-Profile aller Targets neu und legt sie ins
  # Zertifikate-Repo. Nötig, wenn sich Capabilities der App-IDs ändern (z. B. App Groups) oder ein Target dazukommt.
  # Braucht Schreibrecht aufs Zertifikate-Repo (MATCH_GIT_WRITE_AUTHORIZATION); die beta-Lane liest danach wie gewohnt.
  desc "Regenerate the App Store provisioning profiles of all targets"
  lane :profiles do
    setup_ci if is_ci

    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: false
    )

    match(
      type: "appstore",
      readonly: false,
      force: true,
      app_identifier: [
        "com.kellner.SwimInstructor",
        "com.kellner.SwimInstructor.watchkitapp",
        "com.kellner.SwimInstructor.widgets",
        "com.kellner.SwimInstructor.watchkitapp.widgets"
      ],
      git_basic_authorization: ENV["MATCH_GIT_WRITE_AUTHORIZATION"]
    )
  end

  desc "Build, sign and upload a new build to TestFlight"
  lane :beta do
    # Without this, codesign can hang forever in headless CI waiting for a keychain-access
    # prompt that never appears (no one's there to click "Allow") - setup_ci creates a
    # temporary, non-interactive keychain and grants codesign access to it up front.
    setup_ci if is_ci

    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      # Raw .p8 PEM content, not base64 - one less encode/decode/copy-paste step to get wrong.
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: false
    )

    generate_project

    match(type: "appstore", readonly: is_ci)

    targets_to_bundle_ids = {
      "SwimInstructor" => "com.kellner.SwimInstructor",
      "SwimInstructorWatch" => "com.kellner.SwimInstructor.watchkitapp",
      "SwimInstructorWidgets" => "com.kellner.SwimInstructor.widgets",
      "SwimInstructorWatchWidgets" => "com.kellner.SwimInstructor.watchkitapp.widgets"
    }

    # project.yml keeps CODE_SIGN_STYLE Automatic for convenient local Xcode use, but xcodebuild
    # in CI has no GUI to pick a team in, so explicitly switch to the profiles match just fetched.
    targets_to_bundle_ids.each do |target, bundle_id|
      update_code_signing_settings(
        use_automatic_signing: false,
        path: "SwimInstructor.xcodeproj",
        team_id: ENV["APPLE_TEAM_ID"],
        code_sign_identity: "Apple Distribution",
        bundle_identifier: bundle_id,
        profile_name: ENV["sigh_#{bundle_id}_appstore_profile-name"],
        targets: [target]
      )
    end

    increment_build_number(
      build_number: (latest_testflight_build_number + 1).to_s,
      xcodeproj: "SwimInstructor.xcodeproj"
    )

    # gym/build_app keeps writing its own "app-store" into the generated plist no matter what's
    # passed via export_options: (hash or a full custom plist file) - tried both, both got
    # silently overridden. Only reliable fix left: skip gym for archive+export and call
    # xcodebuild directly, so nothing can rewrite our exportOptions.plist behind our back.
    repo_root = File.expand_path("..", __dir__)
    archive_path = File.join(repo_root, "build", "SwimInstructor.xcarchive")
    export_dir = File.join(repo_root, "build", "export")
    export_options_path = File.join(repo_root, "ExportOptions.plist")
    ipa_path = File.join(export_dir, "SwimInstructor.ipa")

    provisioning_profiles_xml = targets_to_bundle_ids.values.map do |bundle_id|
      profile_name = ENV["sigh_#{bundle_id}_appstore_profile-name"]
      "        <key>#{bundle_id}</key>\n        <string>#{profile_name}</string>"
    end.join("\n")

    File.write(export_options_path, <<~PLIST)
      <?xml version="1.0" encoding="UTF-8"?>
      <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
      <plist version="1.0">
      <dict>
        <key>method</key>
        <string>app-store-connect</string>
        <key>signingStyle</key>
        <string>manual</string>
        <key>teamID</key>
        <string>#{ENV["APPLE_TEAM_ID"]}</string>
        <key>provisioningProfiles</key>
        <dict>
      #{provisioning_profiles_xml}
        </dict>
      </dict>
      </plist>
    PLIST

    FileUtils.mkdir_p(File.join(repo_root, "build"))

    Dir.chdir(repo_root) do
      sh(
        "xcodebuild",
        "-scheme", "SwimInstructor",
        "-project", "SwimInstructor.xcodeproj",
        "-destination", "generic/platform=iOS",
        "-archivePath", archive_path,
        "archive"
      )

      sh(
        "xcodebuild",
        "-exportArchive",
        "-archivePath", archive_path,
        "-exportPath", export_dir,
        "-exportOptionsPlist", export_options_path
      )
    end

    upload_to_testflight(
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end
end
